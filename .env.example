# Healthcare Claims - Environment Configuration Example
# Copy this file to .env and update the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Connection URI - UPDATE THIS WITH YOUR MONGODB CONNECTION
# For local development: mongodb://localhost:27017
# For production: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI=mongodb://localhost:27017

# Service-specific database names
CLAIMS_DB_NAME=uhg_claims
NOTIFICATIONS_DB_NAME=web_notifications

# =============================================================================
# WEB PUSH NOTIFICATION CONFIGURATION (VAPID Keys)
# =============================================================================

# VAPID keys for web push notifications - GENERATE AND UPDATE THESE
# Generate with: node generate-vapid-keys.js
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@yourcompany.com

# =============================================================================
# OPTIONAL: CORS AND OTHER SETTINGS
# =============================================================================

# Environment identifier
ENVIRONMENT=development

# Comma-separated list of allowed origins for CORS
# For local development:
# CORS_ORIGINS=http://localhost:4200,http://localhost:4201
# For Vercel deployment, add your Vercel domain:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:4200,http://localhost:4201

# =============================================================================
# VERCEL DEPLOYMENT NOTES
# =============================================================================

# When deploying to Vercel:
# 1. Set these environment variables in your Vercel project settings
# 2. Update MONGODB_URI to point to your production MongoDB instance
# 3. Generate new VAPID keys for production use
# 4. Update CORS_ORIGINS to include your Vercel domain
# 5. Set ENVIRONMENT=production

# Frontend applications will automatically detect the environment:
# - localhost/127.0.0.1: Uses localhost:8080 and localhost:8000 for APIs
# - Production domains: Uses /api/claims and /api/notify (proxied to AWS Lambda)

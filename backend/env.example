# Healthcare Claims - Environment Configuration Example
# Copy this file to .env and update the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Connection URI
# For local development:
MONGODB_URI=mongodb://localhost:27017

# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority

# Service-specific database names (recommended for production)
CLAIMS_DB_NAME=uhg_claims
NOTIFICATIONS_DB_NAME=web_notifications

# Alternative: Use a single database for both services (simpler for development)
# DB_NAME=healthcare_claims_unified

# =============================================================================
# WEB PUSH NOTIFICATION CONFIGURATION (VAPID Keys)
# =============================================================================

# VAPID keys for web push notifications
# Generate with: node generate-vapid-keys.js or npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@yourcompany.com

# =============================================================================
# OPTIONAL: CORS AND OTHER SETTINGS
# =============================================================================

# Comma-separated list of allowed origins for CORS
# CORS_ORIGINS=http://localhost:4200,http://localhost:4201,https://yourdomain.com

# =============================================================================
# ENVIRONMENT-SPECIFIC SETTINGS
# =============================================================================

# Environment identifier (development, staging, production)
ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Healthcare Claims - Environment Configuration Template
# Copy this file to .env and update the values as needed

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Connection URI
# For local development: mongodb://localhost:27017
# For Atlas: mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Database Names (can be the same database for both services if desired)
CLAIMS_DB_NAME=uhg_claims
NOTIFICATIONS_DB_NAME=web_notifications

# Alternative: Use a single database for both services (uncomment if preferred)
# DB_NAME=healthcare_claims_unified

# =============================================================================
# WEB PUSH NOTIFICATION CONFIGURATION (VAPID Keys)
# =============================================================================

# VAPID keys for web push notifications
# Generate new keys with: node generate-vapid-keys.js or npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@healthcareclaims.com

# =============================================================================
# OPTIONAL: CORS AND OTHER SETTINGS
# =============================================================================

# Comma-separated list of allowed origins for CORS (optional)
# CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:3000

# API Configuration
# CLAIMS_API_PORT=8080
# NOTIFICATIONS_API_PORT=8000

# =============================================================================
# ENVIRONMENT-SPECIFIC SETTINGS
# =============================================================================

# Environment identifier (development, staging, production)
# ENVIRONMENT=development

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - Never commit this file with actual secrets to version control
# - Use different VAPID keys for different environments
# - Rotate credentials regularly in production
# - Consider using a secrets management system for production deployments
